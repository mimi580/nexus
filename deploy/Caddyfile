# Automatic HTTPS (Let's Encrypt) for the NEXUS dashboard and API.
# Point an A record for NEXUS_DOMAIN at this server before starting.
{$NEXUS_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
	reverse_proxy api:8000
}

# Optional public website for landing pages (a separate, customer-facing domain).
# Copy deploy/site.caddy.example to deploy/sites/site.caddy, put your domain in it,
# set PUBLIC_SITE_URL in .env and restart caddy. With no file there, nothing changes.
import sites/*.caddy
