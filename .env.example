# NEXUS AI configuration. Copy to .env and fill in. NEVER commit .env.
NEXUS_ENV=development              # development | production
NEXUS_MODE=simulation              # simulation | production

# Database
DATABASE_URL=postgresql+psycopg://nexus:nexus@localhost:5432/nexus
# Local/dev fallback:
# DATABASE_URL=sqlite+pysqlite:///./data/nexus.sqlite3

REDIS_URL=redis://localhost:6379/0

# Budget (USD). Hard ceiling is enforced in code; this only configures it.
BUDGET_MONTHLY_LIMIT_USD=200
BUDGET_CATEGORY_LIMITS_JSON={"infrastructure":20,"ai_primary":45,"ai_secondary":20,"research_data":30,"email":25,"storage":5,"automation":15,"testing_misc":10,"reserve":30}

# Model providers. Leave blank to run entirely on mock providers.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MODEL_PRIMARY=
MODEL_BULK=
MODEL_CRITIC=

# Outreach. Simulation mode ignores these entirely.
EMAIL_PROVIDER=simulated           # simulated | smtp | api
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_NAME=
EMAIL_API_KEY=
OUTREACH_DAILY_LIMIT=40
OUTREACH_PER_COMPANY_DAY_LIMIT=1
OUTREACH_MAX_FOLLOWUPS=3

# Safety
REQUIRE_HUMAN_APPROVAL_ABOVE_USD=0     # 0 = every financial commitment escalates
ALLOW_REGULATED_AUTONOMOUS_TRANSACTIONS=false
