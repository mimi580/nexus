# NEXUS AI configuration. Copy to .env and fill in. NEVER commit .env.
#   cp .env.example .env
#   python3 scripts/generate_secrets.py >> .env     # adds POSTGRES_PASSWORD, UNSUBSCRIBE_SECRET, DASHBOARD_PASSWORD
# Then check it:   docker compose run --rm api python -m app.cli doctor
# Every setting is explained in docs/USER_GUIDE.md, "Configuration reference".

# ----------------------------------------------------------------------------
# Mode
# ----------------------------------------------------------------------------
NEXUS_ENV=production               # development | production (production requires a dashboard login)
NEXUS_MODE=simulation              # simulation (fake world, nothing sent) | production (real research and email)
WORKER_INTERVAL_SECONDS=300        # how often the worker runs a cycle

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
NEXUS_DOMAIN=nexus.example.com     # the dashboard address; point its DNS A record at your server
PUBLIC_BASE_URL=https://nexus.example.com   # used for one-click unsubscribe links in emails

# Database: docker compose builds DATABASE_URL from POSTGRES_PASSWORD automatically.
# For local development without Docker:
# DATABASE_URL=sqlite+pysqlite:///./data/nexus.sqlite3

# ----------------------------------------------------------------------------
# Dashboard login (required in production)
# ----------------------------------------------------------------------------
DASHBOARD_USERNAME=francis
# DASHBOARD_PASSWORD is generated by scripts/generate_secrets.py

# ----------------------------------------------------------------------------
# Budget (USD). The USD 200 hard ceiling is enforced in code; lower values are honoured.
# ----------------------------------------------------------------------------
BUDGET_MONTHLY_LIMIT_USD=200
BUDGET_CATEGORY_LIMITS_JSON={"infrastructure":20,"ai_primary":45,"ai_secondary":20,"research_data":30,"email":25,"storage":5,"automation":15,"testing_misc":10,"reserve":30}

# ----------------------------------------------------------------------------
# AI model (one is required in production; mock models are never used there)
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
MODEL_PRIMARY=                     # default claude-sonnet-5-5 (reasoning: market research, strategy)
MODEL_BULK=                        # default claude-haiku-4-5-20251001 (extraction, classification, copy)
MODEL_CRITIC=                      # default claude-haiku-4-5-20251001
# Alternative or backup: any OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_PRIMARY=
OPENAI_MODEL_BULK=
OPENAI_MODEL_CRITIC=

# ----------------------------------------------------------------------------
# Web research (required in production)
# ----------------------------------------------------------------------------
SEARCH_PROVIDER=none               # brave | tavily | serper | none
SEARCH_API_KEY=
SEARCH_COST_PER_QUERY_USD=0.005    # what your plan charges per query; charged to the research budget
RESEARCH_MAX_QUERIES_PER_TASK=3
RESEARCH_MAX_PAGES_PER_TASK=4
FETCH_USER_AGENT=NEXUS-research/0.2 (+contact via sender address)

# ----------------------------------------------------------------------------
# Sender identity (required in production; printed in every email footer)
# ----------------------------------------------------------------------------
BUSINESS_NAME=
BUSINESS_POSTAL_ADDRESS=           # e.g. P.O. Box 1234-00100, Nairobi, Kenya
EMAIL_SENDER_NAME=
EMAIL_SENDER_ADDRESS=              # a mailbox on your separate outreach domain
EMAIL_REPLY_TO=                    # optional; defaults to the sender address

# ----------------------------------------------------------------------------
# Sending (SMTP) - required in production
# ----------------------------------------------------------------------------
EMAIL_PROVIDER=simulated           # simulated | smtp
SMTP_HOST=                         # e.g. smtp.gmail.com, smtp.zoho.com, smtp.office365.com
SMTP_PORT=587
SMTP_SECURITY=starttls             # starttls (port 587) | ssl (port 465)
SMTP_USERNAME=
SMTP_PASSWORD=                     # use an app password where your provider supports them

# ----------------------------------------------------------------------------
# Reading replies, bounces and opt-outs (IMAP) - strongly recommended
# ----------------------------------------------------------------------------
IMAP_HOST=                         # e.g. imap.gmail.com, imap.zoho.com, outlook.office365.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# ----------------------------------------------------------------------------
# Outreach limits (start low on a new domain and raise gradually)
# ----------------------------------------------------------------------------
OUTREACH_DAILY_LIMIT=10
OUTREACH_PER_COMPANY_DAY_LIMIT=1
OUTREACH_MAX_FOLLOWUPS=2

# ----------------------------------------------------------------------------
# Alerts to you
# ----------------------------------------------------------------------------
NOTIFY_CHANNELS=log                # comma list of: log, telegram, email
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPERATOR_EMAIL=                    # your personal address for email alerts (sent through SMTP above)
NOTIFY_MAX_PER_HOUR=10

# ----------------------------------------------------------------------------
# Safety
# ----------------------------------------------------------------------------
REQUIRE_OUTREACH_APPROVAL=true         # every first-contact email and follow-up waits for your approval; set false once you trust the drafts
REQUIRE_HUMAN_APPROVAL_ABOVE_USD=0     # 0 = every financial commitment goes to you
ALLOW_REGULATED_AUTONOMOUS_TRANSACTIONS=false
