# NEXUS AI configuration. Copy to .env and fill in. NEVER commit .env.
#   cp .env.example .env
#   python3 scripts/generate_secrets.py >> .env     # adds POSTGRES_PASSWORD, UNSUBSCRIBE_SECRET, DASHBOARD_PASSWORD
# Then check it:   docker compose run --rm api python -m app.cli doctor
# Every setting is explained in docs/USER_GUIDE.md, "Configuration reference".

# ----------------------------------------------------------------------------
# Mode
# ----------------------------------------------------------------------------
NEXUS_ENV=production               # development | production (production requires a dashboard login)
NEXUS_MODE=simulation              # simulation (fake world, nothing sent) | production (real research and email)
WORKER_INTERVAL_SECONDS=300        # how often the worker runs a cycle

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
NEXUS_DOMAIN=nexus.example.com     # the dashboard address; point its DNS A record at your server
PUBLIC_BASE_URL=https://nexus.example.com   # used for one-click unsubscribe links in emails

# Database: docker compose builds DATABASE_URL from POSTGRES_PASSWORD automatically.
# For local development without Docker:
# DATABASE_URL=sqlite+pysqlite:///./data/nexus.sqlite3

# ----------------------------------------------------------------------------
# Dashboard login (required in production)
# ----------------------------------------------------------------------------
DASHBOARD_USERNAME=francis
# DASHBOARD_PASSWORD is generated by scripts/generate_secrets.py

# ----------------------------------------------------------------------------
# Budget (USD). A hard monthly ceiling: no AI, research, e-mail or ad spend can exceed it.
BUDGET_MONTHLY_LIMIT_USD=500
BUDGET_CATEGORY_LIMITS_JSON={"infrastructure":20,"ai_primary":45,"ai_secondary":20,"research_data":30,"email":25,"storage":5,"automation":15,"testing_misc":10,"reserve":30,"ads":300}

# ----------------------------------------------------------------------------
# AI model (one is required in production; mock models are never used there)
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
MODEL_PRIMARY=                     # default claude-sonnet-5-5 (reasoning: market research, strategy)
MODEL_BULK=                        # default claude-haiku-4-5-20251001 (extraction, classification, copy)
MODEL_CRITIC=                      # default claude-haiku-4-5-20251001
# Alternative or backup: any OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_PRIMARY=
OPENAI_MODEL_BULK=
OPENAI_MODEL_CRITIC=

# ----------------------------------------------------------------------------
# Web research (required in production)
# ----------------------------------------------------------------------------
SEARCH_PROVIDER=none               # serper (recommended: Google results + business listings) | brave | tavily | none
SEARCH_API_KEY=
SEARCH_COST_PER_QUERY_USD=0.001    # your plan's price per query (Serper ~0.001, Brave 0.005, Tavily 0.008)
RESEARCH_MAX_QUERIES_PER_TASK=3
RESEARCH_MAX_PAGES_PER_TASK=4
FETCH_USER_AGENT=NEXUS-research/0.2 (+contact via sender address)

# ----------------------------------------------------------------------------
# Sender identity (required in production; printed in every email footer)
# ----------------------------------------------------------------------------
BUSINESS_NAME=
BUSINESS_POSTAL_ADDRESS=           # e.g. P.O. Box 1234-00100, Nairobi, Kenya
EMAIL_SENDER_NAME=
EMAIL_SENDER_ADDRESS=              # a mailbox on your separate outreach domain
EMAIL_REPLY_TO=                    # optional; defaults to the sender address

# ----------------------------------------------------------------------------
# Sending (SMTP) - required in production
# ----------------------------------------------------------------------------
EMAIL_PROVIDER=simulated           # simulated | smtp
SMTP_HOST=                         # e.g. smtp.gmail.com, smtp.zoho.com, smtp.office365.com
SMTP_PORT=587
SMTP_SECURITY=starttls             # starttls (port 587) | ssl (port 465)
SMTP_USERNAME=
SMTP_PASSWORD=                     # use an app password where your provider supports them

# ----------------------------------------------------------------------------
# Reading replies, bounces and opt-outs (IMAP) - strongly recommended
# ----------------------------------------------------------------------------
IMAP_HOST=                         # e.g. imap.gmail.com, imap.zoho.com, outlook.office365.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# ----------------------------------------------------------------------------
# Outreach limits (start low on a new domain and raise gradually)
# ----------------------------------------------------------------------------
OUTREACH_DAILY_LIMIT=10
OUTREACH_PER_COMPANY_DAY_LIMIT=1
OUTREACH_MAX_FOLLOWUPS=2
SUPPLIER_RFQ_DAILY_LIMIT=10        # requests for quotation to suppliers per day
SUPPLIER_RFQ_MAX_FOLLOWUPS=2
SUPPLIER_RFQ_FOLLOWUP_DAYS=5

# ----------------------------------------------------------------------------
# Alerts to you
# ----------------------------------------------------------------------------
NOTIFY_CHANNELS=log                # comma list of: log, telegram, email
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPERATOR_EMAIL=                    # your personal address for email alerts (sent through SMTP above)
NOTIFY_MAX_PER_HOUR=10

# ----------------------------------------------------------------------------
# Safety
# ----------------------------------------------------------------------------
REQUIRE_OUTREACH_APPROVAL=false        # false: buyer outreach, follow-ups and supplier RFQs send on their own. true: each waits for your approval
REQUIRE_HUMAN_APPROVAL_ABOVE_USD=0     # 0 = every financial commitment goes to you
ALLOW_REGULATED_AUTONOMOUS_TRANSACTIONS=false

# ----------------------------------------------------------------------------
# Public website: landing pages and enquiry form (needed for ads)
# ----------------------------------------------------------------------------
PUBLIC_SITE_URL=                   # e.g. https://www.yourbrand.com (see deploy/site.caddy.example); defaults to PUBLIC_BASE_URL
WHATSAPP_NUMBER=                   # optional, digits with country code, e.g. 254712345678 (adds a WhatsApp button)
LEAD_RESPONSE_PROMISE=within one business day

# ----------------------------------------------------------------------------
# Advertising (Google Ads + Meta). Pharmaceuticals are never advertised.
# Spend counts against the "ads" line of BUDGET_CATEGORY_LIMITS_JSON.
# ----------------------------------------------------------------------------
ADS_ENABLED=false
ADS_REQUIRE_LAUNCH_APPROVAL=true   # true: each new campaign waits in Reviews; optimisation afterwards is automatic
ADS_DEFAULT_DAILY_BUDGET_USD=5
ADS_MIN_DAILY_BUDGET_USD=1
ADS_TARGET_COST_PER_LEAD_USD=15    # what an enquiry is worth paying for; drives pausing and budget moves
ADS_MAX_CAMPAIGNS_PER_PLATFORM=6
ADS_PRUNE_MIN_CLICKS=150
ADS_FX_RATES_JSON=                 # only if an ad account is not in USD, e.g. {"KES": 129.5} (units per 1 USD)

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=            # the ad account, 10 digits (dashes allowed)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=      # only if you sign in through a manager (MCC) account
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_CURRENCY=USD
GOOGLE_ADS_CONVERSION_ACTION_LEAD= # numeric id of an "Import from clicks" conversion action for enquiries
GOOGLE_ADS_CONVERSION_ACTION_WON=  # numeric id of one for won deals (optional)

META_ACCESS_TOKEN=                 # system-user token with ads_management and pages permissions
META_AD_ACCOUNT_ID=                # digits only, without act_
META_PAGE_ID=                      # your Facebook Page
META_PIXEL_ID=                     # dataset/pixel for Conversions API (optional but recommended)
META_API_VERSION=v26.0
META_AD_ACCOUNT_CURRENCY=USD
